{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@pdfplatform/ts-config/react-library",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"],
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true
  },
  "include": ["src", "tailwind.config.ts"]
}
